APP_NAME="Url Shortener"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://app.orturl.com
APP_WEBSITE=https://app.orturl.com/login

DOMAIN_MAIN=sh.orturl.com
DOMAIN_CNAME=cname.orturl.com

# Server-side rendering. Off: everything this app serves sits behind a login,
# where nothing crawls and nobody shares a link for its preview, so rendering
# on the server costs a second process and a class of silent failure and buys
# nothing. The wiring is intact — set this to true and `npm run dev` serves
# SSR itself; in production run `php artisan inertia:start-ssr` alongside
# the app.
INERTIA_SSR_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lua
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Reverb. Broadcasting is wired but nothing publishes yet; set
# BROADCAST_CONNECTION=reverb once there is an event to send. The VITE_
# copies are what resources/js/echo.ts reads in the browser.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

RESEND_API_KEY=

MAIL_MAILER=resend
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@notify.orturl.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# The app's own origin, used by the frontend to resolve relative URLs.
# Inlined at build time, so rebuild after changing APP_URL.
VITE_APP_URL="${APP_URL}"

# PostHog (optional - product analytics; off by default, self-hosted installs can ignore)
POSTHOG_ENABLED=false
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

VITE_POSTHOG_ENABLED="${POSTHOG_ENABLED}"
VITE_POSTHOG_API_KEY="${POSTHOG_API_KEY}"
VITE_POSTHOG_HOST="${POSTHOG_HOST}"

# Social sign-in (optional - each provider is hidden until both values are set)
# Social login. A provider needs both the switch and its credentials below:
# with the credentials empty the button is hidden either way.
GOOGLE_AUTH_ENABLED=true
GITHUB_AUTH_ENABLED=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Mapbox (optional - powers the analytics map; the card explains itself when unset)
MAPBOX_TOKEN=
